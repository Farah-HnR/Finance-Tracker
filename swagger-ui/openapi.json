  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "balance"
        ],
        "title": "AccountResponse"
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "cash",
          "bank",
          "credit_card",
          "savings"
        ],
        "title": "AccountType"
      },
      "BudgetCreate": {
        "properties": {
          "category_id": {
            "type": "string",
            "format": "uuid",
            "title": "Category Id"
          },
          "month": {
            "type": "string",
            "format": "date",
            "title": "Month"
          },
          "limit_amount": {
            "type": "number",
            "title": "Limit Amount"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "month",
          "limit_amount"
        ],
        "title": "BudgetCreate"
      },
      "BudgetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "title": "Category Id"
          },
          "month": {
            "type": "string",
            "format": "date",
            "title": "Month"
          },
          "limit_amount": {
            "type": "number",
            "title": "Limit Amount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category_id",
          "month",
          "limit_amount"
        ],
        "title": "BudgetResponse"
      },
      "BudgetStatusItem": {
        "properties": {
          "budget_id": {
            "type": "string",
            "format": "uuid",
            "title": "Budget Id"
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "title": "Category Id"
          },
          "category_name": {
            "type": "string",
            "title": "Category Name"
          },
          "limit_amount": {
            "type": "number",
            "title": "Limit Amount"
          },
          "spent": {
            "type": "number",
            "title": "Spent"
          },
          "remaining": {
            "type": "number",
            "title": "Remaining"
          },
          "percentage_used": {
            "type": "number",
            "title": "Percentage Used"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "budget_id",
          "category_id",
          "category_name",
          "limit_amount",
          "spent",
          "remaining",
          "percentage_used",
          "status"
        ],
        "title": "BudgetStatusItem"
      },
      "BudgetStatusResponse": {
        "properties": {
          "month": {
            "type": "string",
            "title": "Month"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BudgetStatusItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total_budget": {
            "type": "number",
            "title": "Total Budget"
          },
          "total_spent": {
            "type": "number",
            "title": "Total Spent"
          },
          "total_remaining": {
            "type": "number",
            "title": "Total Remaining"
          }
        },
        "type": "object",
        "required": [
          "month",
          "items",
          "total_budget",
          "total_spent",
          "total_remaining"
        ],
        "title": "BudgetStatusResponse"
      },
      "CategoryBreakdownItem": {
        "properties": {
